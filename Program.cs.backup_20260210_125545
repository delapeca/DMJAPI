using Microsoft.AspNetCore.Authentication.JwtBearer;           // (actualment no s’està usant explícitament aquí, però es manté)
using Microsoft.EntityFrameworkCore;                           // EF Core (SQLite per qrloxone.db)
using Microsoft.Extensions.DependencyInjection;                // DI container
using Microsoft.Extensions.Options;                            // IOptions<T>
using Microsoft.IdentityModel.Tokens;                          // (no s’està usant explícitament aquí, però es manté)
using Swashbuckle.AspNetCore.SwaggerGen;                       // Swagger + IOperationFilter
using System.Net.Http.Headers;                                 // Authorization header pel HttpClient de Loxone
using System.Text;                                             // Base64
using XNDmjApi.Functions;                                      // Dades/Funcions/ApplicationSettings
using XNDmjApi.Infrastructure.Options;                         // Options (AdminOptions, TokenPolicyOptions, etc.)
using XNDmjApi.Infrastructure.Services;                        // DbMigrationRunner, etc.
using XNDmjApi.Infrastructure.Middleware;                      // ApiExceptionJsonMiddleware
using XNDmjApi.Loxone.Data;                                    // AppDbContext (SQLite)
using XNDmjApi.Loxone.Options;                                 // LoxoneOptions
using XNDmjApi.Loxone.Services;                                // LoxoneCommandService
using XNDmjApi.Models;                                         // ApplicationSettings
using XNDmjApi.QrMulti.Services;                               // QrMultiDbInitializer
using XNDmjApi.Services;                                       // Serveis API (CustomerPortfolioService, etc.)

// IMPORTANT: en el teu setup, aquest és el model que compila
using Microsoft.OpenApi;

var builder = WebApplication.CreateBuilder(args);

// ============================================================
// [1] MVC Controllers + Endpoints discovery
// ============================================================
// Registra controllers (atributs [ApiController]) i permet que Swagger descobreixi endpoints.
builder.Services.AddControllers();
builder.Services.AddEndpointsApiExplorer();

// ============================================================
// [2] Swagger / OpenAPI
// ============================================================
// Swagger aquí és principalment per documentació i proves via UI.
// IMPORTANT: Les definicions de "SecurityDefinition" NO imposen auth real, només serveixen per UI/documentació.
builder.Services.AddSwaggerGen(c =>
{
    // Evita col·lisions de noms en esquemes (molt útil quan hi ha DTOs amb mateix nom en namespaces diferents)
    c.CustomSchemaIds(t => t.FullName ?? t.Name);

    // Suport de càrrega d'arxius (IFormFile) a Swagger (model Microsoft.OpenApi)
    c.MapType<IFormFile>(() => new OpenApiSchema
    {
        Type = JsonSchemaType.String,
        Format = "binary"
    });

    // --- Definicions d'API Keys (documentació/UI) ---
    c.AddSecurityDefinition("AdminApiKey", new OpenApiSecurityScheme
    {
        Description = "Admin API Key (header AdminApiKey).",
        Name = "AdminApiKey",
        In = ParameterLocation.Header,
        Type = SecuritySchemeType.ApiKey
    });

    c.AddSecurityDefinition("ProfileApiKey", new OpenApiSecurityScheme
    {
        Description = "Profile API Key (header ProfileApiKey).",
        Name = "ProfileApiKey",
        In = ParameterLocation.Header,
        Type = SecuritySchemeType.ApiKey
    });

    // Header només als endpoints que toca (no global).
    // Això afegeix el camp a Swagger per operar amb "Authorize"/headers, però NO aplica auth real.
    c.OperationFilter<AddPerEndpointApiKeyHeaderParameter>();
});

// ============================================================
// [3] Config base "BBDD" -> ApplicationSettings
// ============================================================
// Carrega configuració de BBDD (servidor SQL, user/pwd, etc.) a ApplicationSettings (estàtic).
builder.Configuration.GetSection("BBDD").Get<ApplicationSettings>();

// ============================================================
// [4] CORS
// ============================================================
// Permet CORS (més avall definim AllowAnyHeader/AllowAnyMethod/origins "*").
builder.Services.AddCors();

// ============================================================
// [5] Serveis del domini (DI)
// ============================================================
// Exemples:
// - CustomerPortfolioService: servei existent (extranet/intranet)
builder.Services.AddScoped<CustomerPortfolioService>();

// ============================================================
// [6] LOXONE · Options + serveis + DB SQLite
// ============================================================

// Options (config) per Loxone, Admin, TokenPolicy, migracions i perfils d’ApiKey
builder.Services.Configure<LoxoneOptions>(builder.Configuration.GetSection("Loxone"));
builder.Services.Configure<AdminOptions>(builder.Configuration.GetSection("Admin"));
builder.Services.Configure<TokenPolicyOptions>(builder.Configuration.GetSection("TokenPolicy"));
builder.Services.Configure<DbMigrationsOptions>(builder.Configuration.GetSection("DbMigrations"));

// ApiKeyProfiles (per Prod/Test) - això alimenta el middleware de perfil
builder.Services.Configure<XNDmjApi.Infrastructure.ApiKeys.ApiKeyProfilesOptions>(builder.Configuration.GetSection("ApiKeyProfiles"));

// [NOU] Config per ApiKeyProfilesMiddleware (namespace Infrastructure.Options)
//builder.Services.Configure<XNDmjApi.Infrastructure.Options.ApiKeyProfilesOptions>(builder.Configuration.GetSection("ApiKeyProfiles"));

// Serveis específics
builder.Services.AddScoped<XNDmjApi.Services.SapChangeRequestsUdoService>();

// Inicialitzadors/migracions (SQLite)
builder.Services.AddScoped<DbMigrationRunner>();
builder.Services.AddScoped<QrMultiDbInitializer>();

// DbContext SQLite (qrloxone.db)
builder.Services.AddDbContext<AppDbContext>(options =>
{
    var cs = builder.Configuration.GetConnectionString("LoxoneDb");
    if (string.IsNullOrWhiteSpace(cs))
        cs = "Data Source=App_Data\\qrloxone.db";

    options.UseSqlite(cs);
});

// HttpClient "loxone" amb BaseAddress + Basic Auth
builder.Services.AddHttpClient("loxone").ConfigureHttpClient((sp, client) =>
{
    var opt = sp.GetRequiredService<IOptions<LoxoneOptions>>().Value;

    if (!string.IsNullOrWhiteSpace(opt.BaseUrl))
    {
        var baseUrl = opt.BaseUrl.TrimEnd('/') + "/";
        client.BaseAddress = new Uri(baseUrl);
    }

    if (!string.IsNullOrWhiteSpace(opt.Username))
    {
        var token = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{opt.Username}:{opt.Password}"));
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Basic", token);
    }
});

builder.Services.AddScoped<TokenService>();
builder.Services.AddScoped<LoxoneCommandService>();

// ============================================================
// [7] Build pipeline
// ============================================================
var app = builder.Build();

// ============================================================
// [8] Bootstrap DB (idempotent) - s'executa a l'arrencada
// ============================================================
using (var scope = app.Services.CreateScope())
{
    var runner = scope.ServiceProvider.GetRequiredService<DbMigrationRunner>();
    await runner.ApplyOnStartupAsync(CancellationToken.None);
}

// ============================================================
// [9] Middleware d’excepcions (JSON) - el tens especialitzat per alguns endpoints
// ============================================================
app.UseMiddleware<ApiExceptionJsonMiddleware>();

// ============================================================
// [10] Swagger ON sempre + static files (per servir /swagger i assets)
// ============================================================
app.UseSwagger();
app.UseStaticFiles();
app.UseSwaggerUI(c =>
{
    // Manté l’autorització (headers) a la UI entre refreshos
    c.ConfigObject.AdditionalItems["persistAuthorization"] = "true";
    c.SwaggerEndpoint("/swagger/v1/swagger.json", "XNDmjApi v1");
    // Sense interceptors (en el teu cas no s'aplicaven)
});

// ============================================================
// [11] HTTPS redirection (si està configurat)
// ============================================================
app.UseHttpsRedirection();

// ============================================================
// [12] AuthN/AuthZ del framework
// ============================================================
// NOTE: En el teu projecte hi ha UseAuthentication/UseAuthorization encara que
// moltes rutes facin "auth" per API key via middleware propi.
app.UseAuthentication();
app.UseAuthorization();

// ============================================================
// [13] CORS policy runtime
// ============================================================
app.UseCors(options =>
    options.WithOrigins("*")
           .AllowAnyHeader()
           .AllowAnyMethod());

// ============================================================
// [14] Middleware propi: resolució de perfil per ApiKey (ProfileApiKey / fallback)
// ============================================================
// ANTIC (comentari original):
//   // X-Api-Key → perfil (PROD/TEST) · només per /api/SapChangeRequestsUdo
//
// SUBSTITUÏT PER (nota):
//   Ara el middleware pot aplicar-se també a /api/clients/self (segons la seva lògica interna).
//   El comportament real depèn del fitxer ApiKeyProfileMiddleware.
app.UseMiddleware<XNDmjApi.Infrastructure.ApiKeys.ApiKeyProfileMiddleware>();
//app.UseMiddleware<XNDmjApi.Infrastructure.Middleware.ApiKeyProfilesMiddleware>();

// [NOU] Middleware de migració: ProfileApiKey (primary) + X-Api-Key (fallback)
// i aplica a /api/SapChangeRequestsUdo i /api/clients/self (segons el teu fitxer)
//app.UseMiddleware<XNDmjApi.Infrastructure.Middleware.ApiKeyProfilesMiddleware>();

// ============================================================
// [15] Map controllers
// ============================================================
app.MapControllers();
app.Run();

// ============================================================
// [16] Swagger OperationFilter (per afegir headers segons controller)
// ============================================================
// Aquest filtre NO aplica seguretat real. Només "pinta" el header a Swagger UI
// per tal que puguis provar fàcilment els endpoints amb el header correcte.

class AddPerEndpointApiKeyHeaderParameter : IOperationFilter
{
    public void Apply(OpenApiOperation operation, OperationFilterContext context)
    {
        // Assegura llista de paràmetres
        if (operation.Parameters == null)
            operation.Parameters = new List<IOpenApiParameter>();

        // Detecta controller (forma estàndard a ASP.NET Core)
        var ctrl =
            context.ApiDescription.ActionDescriptor.RouteValues.TryGetValue("controller", out var c)
                ? c
                : null;

        if (string.IsNullOrWhiteSpace(ctrl))
            return;

        // Admin endpoints (Admin:ApiKey)
        if (IsAdminController(ctrl))
        {
            AddHeaderIfMissing(
                operation,
                "AdminApiKey",
                "Admin API Key per endpoints admin (temporalment també pot existir X-Api-Key al backend)."
            );
            return;
        }

        // Profile endpoints (ApiKeyProfiles)
        if (IsProfileController(ctrl))
        {
            AddHeaderIfMissing(
                operation,
                "ProfileApiKey",
                "Profile API Key per endpoints de perfil (temporalment també pot existir X-Api-Key al backend)."
            );
            return;
        }
    }

    private static bool IsAdminController(string controllerName)
    {
        // Controllers que al teu dump van amb Admin:ApiKey
        // QRController, QrMultiAdminController, QrResolveController
        //
        // NOTE (DMJ) 2026-02-06:
        //   He canviat aquest mètode per TREURE "ClientsSelf" d’Admin i passar-lo a Profile.
        //
        // --- CODI ANTIC (comentat) ---
        // return controllerName.Equals("QR", StringComparison.OrdinalIgnoreCase)
        //     || controllerName.Equals("QrMultiAdmin", StringComparison.OrdinalIgnoreCase)
        //     || controllerName.Equals("QrResolve", StringComparison.OrdinalIgnoreCase)
        //     || controllerName.Equals("ClientsSelf", StringComparison.OrdinalIgnoreCase);
        //
        // --- SUBSTITUÏT PER (nou) ---
        return controllerName.Equals("QR", StringComparison.OrdinalIgnoreCase)
            || controllerName.Equals("QrMultiAdmin", StringComparison.OrdinalIgnoreCase)
            || controllerName.Equals("QrResolve", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsProfileController(string controllerName)
    {
        // Controllers que van amb ProfileApiKey (ApiKeyProfiles -> perfil Prod/Test)
        //
        // NOTE (DMJ) 2026-02-06:
        //   He afegit "ClientsSelf" aquí perquè Swagger indiqui ProfileApiKey en lloc d’AdminApiKey.
        //
        // --- CODI ANTIC (comentat) ---
        // return controllerName.Equals("SapChangeRequestsUdo", StringComparison.OrdinalIgnoreCase);
        //
        // --- SUBSTITUÏT PER (nou) ---
        return controllerName.Equals("SapChangeRequestsUdo", StringComparison.OrdinalIgnoreCase)
            || controllerName.Equals("ClientsSelf", StringComparison.OrdinalIgnoreCase)
            // [DMJ] 2026-02-08 — NOU (només Swagger UI):
            || controllerName.Equals("Items", StringComparison.OrdinalIgnoreCase)
            // ⬅️ AFEGIR AQUESTES 2 LÍNIES
            // [DMJ] 2026-02-10 — NOU (només Swagger UI):
            || controllerName.Equals("SalesOrders", StringComparison.OrdinalIgnoreCase);
    }

    private static void AddHeaderIfMissing(OpenApiOperation operation, string headerName, string description)
    {
        // Evita duplicats: si ja existeix el param headerName, no l’afegeix.
        foreach (var p in operation.Parameters)
        {
            if (string.Equals(p.Name, headerName, StringComparison.OrdinalIgnoreCase) &&
                p.In == ParameterLocation.Header)
                return;
        }

        // Afegeix el paràmetre com a Header al Swagger UI
        operation.Parameters.Add(new OpenApiParameter
        {
            Name = headerName,
            In = ParameterLocation.Header,
            Required = true,
            Schema = new OpenApiSchema { Type = JsonSchemaType.String },
            Description = description
        });
    }
}
