using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.Options;
using System;
using System.Security.Cryptography;
using System.Text;
using System.Threading.Tasks;

namespace XNDmjApi.Infrastructure.ApiKeys
{
    /// <summary>
    /// ApiKeyProfileMiddleware
    /// ----------------------
    /// Objectiu:
    ///   - Llegir la API key d'entrada (preferent: ProfileApiKey; fallback: X-Api-Key i variants)
    ///   - Resoldre el perfil (CompanyDb + SapUser + SapPassword) des de ApiKeyProfilesOptions.Profiles
    ///   - Deixar-lo a HttpContext.Items[HttpContextItemKey] perquè Controllers/Services decideixin BD/credencials
    ///
    /// IMPORTANT:
    ///   - Aquest middleware NOMÉS s'aplica a certs prefixos de ruta.
    ///   - Afegir nous endpoints "profile-scoped" = afegir un nou StartsWithSegments(...) a isProfileScoped.
    ///   - No cal tocar la lògica de resolució de perfils.
    /// </summary>
    public sealed class ApiKeyProfileMiddleware
    {
        // Clau estable per consultar el perfil des de controllers/serveis
        public const string HttpContextItemKey = "dmj.api.apikey.profile";

        private readonly RequestDelegate _next;
        private readonly ApiKeyProfilesOptions _opt;

        public ApiKeyProfileMiddleware(RequestDelegate next, IOptions<ApiKeyProfilesOptions> opt)
        {
            _next = next;
            _opt = opt?.Value ?? new ApiKeyProfilesOptions();
        }

        // ─────────────────────────────────────────────────────────────
        // RUTES "PROFILE-SCOPED"
        // ─────────────────────────────────────────────────────────────
        // ✅ Afegir nous endpoints protegits per ProfileApiKey:
        //    - AFEGEIX el prefix aquí (una línia)
        //    - NO toquis la resta de la lògica del middleware
        private static readonly string[] ProfileScopedPrefixes = new[]
        {
            "/api/SapChangeRequestsUdo",
            "/api/clients/self",
            "/api/Login/RequestPasswordReset",
            "/api/Login/ResetPasswordByToken",
            "/api/Login/ResetPassword",

            // [DMJ] 2026-02-08 — NOU:
            // Tot /api/Items/* ha de seleccionar BBDD segons ProfileApiKey (prod/test)
            "/api/Items",
            "/api/SalesOffers",
            "/api/SalesOrders",
        };

        private static bool AppliesToPath(PathString path)
        {
            foreach (var pref in ProfileScopedPrefixes)
            {
                if (path.StartsWithSegments(pref, StringComparison.OrdinalIgnoreCase))
                    return true;
            }
            return false;
        }


        public async Task Invoke(HttpContext ctx)
        {
            if (ctx == null) { await _next(ctx!); return; }

            // ─────────────────────────────────────────────────────────────
            // PAS 0) Decideix si aquest middleware aplica a la request actual
            // ─────────────────────────────────────────────────────────────
            var path = ctx.Request.Path;

            // --- CODI ANTIC (ABANS) ---
            // IMPORTANT: abans només aplicava a SapChangeRequestsUdo
            // if (!path.StartsWithSegments("/api/SapChangeRequestsUdo", StringComparison.OrdinalIgnoreCase))
            // {
            //     await _next(ctx);
            //     return;
            // }

            // --- CODI NOU (ARA) ---
            // Afegim /api/clients/self perquè aquests endpoints també necessiten perfil + selecció de DB.
            // (i mantenim els altres que ja tenies)
            if (!AppliesToPath(path))
            {
                await _next(ctx);
                return;
            }


            // ─────────────────────────────────────────────────────────────
            // PAS 1) Validar que la configuració de perfils existeix
            // ─────────────────────────────────────────────────────────────
            // Necessitem: ApiKeyProfilesOptions.Profiles["prod|test|..."] amb ApiKey/CompanyDb/SapUser/SapPassword
            if (_opt.Profiles == null || _opt.Profiles.Count == 0)
            {
                ctx.Response.StatusCode = StatusCodes.Status500InternalServerError;
                await ctx.Response.WriteAsJsonAsync(new
                {
                    ok = false,
                    code = "APIKEY_PROFILES_MISSING",
                    message = "Falta config ApiKeyProfiles (Profiles buida)."
                });
                return;
            }

            // ─────────────────────────────────────────────────────────────
            // PAS 2) Llegir la key entrant (preferent ProfileApiKey; fallback legacy)
            // ─────────────────────────────────────────────────────────────
            // Ordre:
            //   1) Header ProfileApiKey            (nou)
            //   2) Header X-Api-Key / X-API-Key... (legacy)
            //   3) Authorization: Bearer <key>     (extra compat, opcional però útil)
            string incoming = "";

            if (TryGetHeader(ctx, "ProfileApiKey", out incoming))
            {
                // OK
            }
            else if (TryGetHeader(ctx, "X-Api-Key", out incoming)
                  || TryGetHeader(ctx, "X-API-Key", out incoming)
                  || TryGetHeader(ctx, "x-api-key", out incoming))
            {
                // OK (legacy)
            }
            else if (TryGetHeader(ctx, "Authorization", out incoming))
            {
                // Compat: "Bearer <key>"
                if (incoming.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
                    incoming = incoming.Substring(7).Trim();
            }

            incoming = (incoming ?? "").Trim().Trim('"');

            if (string.IsNullOrWhiteSpace(incoming))
            {
                ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
                await ctx.Response.WriteAsJsonAsync(new
                {
                    ok = false,
                    code = "MISSING_API_KEY",
                    message = "Falta header ProfileApiKey (o X-Api-Key durant la transició)."
                });
                return;
            }

            // ─────────────────────────────────────────────────────────────
            // PAS 3) Resoldre el perfil segons la key (comparació en temps constant)
            // ─────────────────────────────────────────────────────────────
            var prof = ResolveProfile(incoming);
            if (prof == null)
            {
                ctx.Response.StatusCode = StatusCodes.Status403Forbidden;
                await ctx.Response.WriteAsJsonAsync(new
                {
                    ok = false,
                    code = "INVALID_API_KEY",
                    message = "API key incorrecta (ProfileApiKey / X-Api-Key)."
                });
                return;
            }

            // ─────────────────────────────────────────────────────────────
            // PAS 4) Guardar el perfil perquè el controller el pugui consumir
            // ─────────────────────────────────────────────────────────────
            // Exemple al controller:
            //   var profile = HttpContext.Items[ApiKeyProfileMiddleware.HttpContextItemKey] as ApiKeyProfile;
            //   ... i a partir d'aquí selecciones DB / credencials.
            ctx.Items[HttpContextItemKey] = prof;

            await _next(ctx);
        }

        // ─────────────────────────────────────────────────────────────
        // Helpers
        // ─────────────────────────────────────────────────────────────

        private ApiKeyProfile? ResolveProfile(string incoming)
        {
            foreach (var kv in _opt.Profiles)
            {
                string name = kv.Key ?? "";
                var cfg = kv.Value;
                if (cfg == null) continue;

                string cfgKey = (cfg.ApiKey ?? "").Trim();
                if (string.IsNullOrWhiteSpace(cfgKey)) continue;

                if (FixedEquals(incoming, cfgKey))
                {
                    return new ApiKeyProfile(
                        name: name,
                        companyDb: (cfg.CompanyDb ?? "").Trim(),
                        sapUser: (cfg.SapUser ?? "").Trim(),
                        sapPassword: (cfg.SapPassword ?? "").Trim()
                    );
                }
            }
            return null;
        }

        private static bool TryGetHeader(HttpContext ctx, string headerName, out string value)
        {
            value = "";
            if (!ctx.Request.Headers.TryGetValue(headerName, out var vals))
                return false;

            // agafem el primer valor
            value = (vals.Count > 0 ? vals[0] : "")?.ToString()?.Trim() ?? "";
            return !string.IsNullOrWhiteSpace(value);
        }

        private static bool FixedEquals(string a, string b)
        {
            if (a == null || b == null) return false;
            var ba = Encoding.UTF8.GetBytes(a);
            var bb = Encoding.UTF8.GetBytes(b);
            if (ba.Length != bb.Length) return false;
            return CryptographicOperations.FixedTimeEquals(ba, bb);
        }
    }
}
